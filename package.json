{
  "name": "agent-culinaire-os",
  "description": "Assistant culinaire IA",
  "author": "Agent Culinaire OS",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npx tsx server.ts",
    "start": "npx tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:server": "npx esbuild server.ts --bundle --platform=node --outfile=dist-server/server.cjs --format=cjs --packages=external",
    "build:exe": "npm run build && npm run build:server && electron-builder -w",
    "build:mac": "npm run build && npm run build:server && electron-builder -m",
    "build:linux": "npm run build && npm run build:server && electron-builder -l",
    "build:all": "npm run build && npm run build:server && electron-builder -wl",
    "verify:perf": "node scripts/verify-perf.mjs",
    "verify:http": "node scripts/verify-http.mjs",
    "verify:sse": "node scripts/verify-sse.mjs",
    "verify:ratelimit": "node scripts/verify-ratelimit.mjs",
    "audit:perf": "node scripts/audit-perf.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:indices": "python3 scripts/ab-indices.py",
    "verify:ci": "node scripts/verify-ci.mjs",
    "verify:purchasing": "python3 scripts/mutation-test-purchasing.py",
    "verify:instance-guard": "node scripts/probe-instance-guard.mjs",
    "verify:instance-mord": "python3 scripts/probe-instance-garde-mord.py",
    "verify:forecast": "python3 scripts/probe-forecast-real.py --semer=decaler",
    "verify:forecast-mord": "python3 scripts/negative-test-forecast-graine.py",
    "verify:ready": "node scripts/probe-ready-parity.mjs",
    "verify:ready-mord": "python3 scripts/negative-test-ready-parity.py",
    "verify:inventory-put": "python3 scripts/negative-test-inventory-put.py",
    "verify:all": "python3 scripts/run-all-gates.py",
    "verify:supplier-price": "python3 scripts/negative-test-supplier-price.py",
    "verify:supplier-import": "python3 scripts/negative-test-supplier-import.py",
    "verify:installeur": "python3 scripts/probe-installeur-morsure.py",
    "verify:import-contract": "node scripts/probe-supplier-import-contract.mjs",
    "verify:documents-validate": "python3 scripts/negative-test-documents-validate.py",
    "verify:supplier-probe": "node scripts/probe-supplier-price-contract.mjs",
    "verify:instance-mord-harnais": "python3 scripts/probe-garde-instance-harnais-mord.py",
    "verify:consume-mord": "python3 scripts/negative-test-consume-contract.py",
    "verify:consume": "npx playwright test test/e2e/consume-contract.spec.ts --reporter=line",
    "verify:post-inventory": "npx playwright test test/e2e/post-inventory-contract.spec.ts --reporter=line",
    "verify:post-inventory-mord": "python3 scripts/negative-test-post-inventory-contract.py",
    "verify:document-items": "npx playwright test test/e2e/document-items-contract.spec.ts --reporter=line",
    "verify:document-items-mord": "python3 scripts/negative-test-document-items.py",
    "verify:document-items-voices": "node scripts/probe-document-items-voices.mjs",
    "verify:split": "python3 scripts/decouper-phases.py --verify",
    "verify:haccp": "npx playwright test test/e2e/haccp-contract.spec.ts --reporter=line",
    "verify:haccp-mord": "python3 scripts/negative-test-haccp-contract.py",
    "verify:recipes": "npx playwright test test/e2e/recipes-contract.spec.ts --reporter=line",
    "verify:recipes-mord": "python3 scripts/negative-test-recipes-contract.py",
    "verify:recipes-voices": "node scripts/probe-recipes-voices.mjs",
    "verify:recipes-put": "node scripts/probe-put-recipes-voices.mjs"
  },
  "build": {
    "appId": "com.agentculinaire.os",
    "productName": "Agent Culinaire OS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-server/**/*",
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "asarUnpack": [
      "**/node_modules/sqlite3/**/*",
      "**/node_modules/@xenova/**/*",
      "**/node_modules/ollama/**/*"
    ]
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@xenova/transformers": "^2.17.2",
    "archiver": "^7.0.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonrepair": "^3.14.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.1.1",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "ollama": "^0.6.3",
    "papaparse": "^5.5.3",
    "pdf-parse": "^1.1.1",
    "pdf-to-img": "^6.0.0",
    "pdf2pic": "^3.2.0",
    "pdfkit": "^0.18.0",
    "playwright": "^1.59.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "^7.0.0",
    "undici": "^8.1.0",
    "vite": "^6.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/sqlite3": "^3.1.11",
    "autoprefixer": "^10.4.21",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "js-yaml": "4.3.2",
    "mime-types": "^3.0.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "0.28.2",
    "@esbuild/darwin-x64": "0.28.2",
    "@esbuild/linux-arm64": "0.28.2",
    "@esbuild/linux-x64": "0.28.2",
    "@esbuild/win32-x64": "0.28.2",
    "@napi-rs/canvas-darwin-arm64": "0.1.100",
    "@napi-rs/canvas-darwin-x64": "0.1.100",
    "@napi-rs/canvas-linux-arm64-gnu": "0.1.100",
    "@napi-rs/canvas-linux-x64-gnu": "0.1.100",
    "@napi-rs/canvas-win32-x64-msvc": "0.1.100",
    "@rollup/rollup-darwin-arm64": "4.63.0",
    "@rollup/rollup-darwin-x64": "4.63.0",
    "@rollup/rollup-linux-arm64-gnu": "4.63.0",
    "@rollup/rollup-linux-x64-gnu": "4.63.0",
    "@rollup/rollup-win32-x64-gnu": "4.63.0",
    "@tailwindcss/oxide-darwin-arm64": "4.3.3",
    "@tailwindcss/oxide-darwin-x64": "4.3.3",
    "@tailwindcss/oxide-linux-arm64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.3",
    "lightningcss-darwin-arm64": "1.32.0",
    "lightningcss-darwin-x64": "1.32.0",
    "lightningcss-linux-arm64-gnu": "1.32.0",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-win32-x64-msvc": "1.32.0"
  }
}
