      const id = Date.now().toString();
      await db.run(
        "INSERT INTO menu_planning (id, date, meal_type, recipe_id, title, recipe_json) VALUES (?, ?, ?, ?, ?, ?)",
        [
          id,
          date,
          meal_type,
          recipe_id || null,
          title,
          JSON.stringify(recipe_json || null),
        ],
      );
      res.json({ status: "success", id });
