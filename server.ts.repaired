            "plat": { "nom": "Nom du plat de résistance...", "ingredients": [{"name": "...", "quantite": "0", "unite": "g"}], "allergens": ["..."], "preparation_steps": "..." },
            "dessert": { "nom": "Nom du dessert...", "ingredients": [{"name": "...", "quantite": "0", "unite": "g"}], "allergens": ["..."], "preparation_steps": "..." }
          }
        ]
      }`;
        const singlePrompt = settings.language === "it" ? \`IMPORTANTE : TUTTA LA TUA RISPOSTA DEVE ESSERE IN ITALIANO.
