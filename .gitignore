node_modules/
build/
dist/
dist-server/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Fichiers sensibles et bases de données
*.db
*.sqlite
local_database.db
agent_culinaire.db

# Fichiers utilitaires de génération de clés / admin
all_keys.txt
keys_found.txt
generate-key.js
keygen.ts

# Scripts d'installation / Admin non destinés au dépot
1_INSTALLER.bat
2_LANCER_SERVEUR.bat
START_CLAUS_IO.bat
lancer-app-windows.bat
NOTICE_INSTALLATION_*.txt
instruction_creation_logiciel.txt

# Backups locaux générés par /api/backup (ne jamais committer)
backup.zip
*.backup

# Artefacts de test (Playwright / vitest) et WAL de SQLite
test-results/
# Chaque suite cree SON repetoire isole (tmp-data, tmp-perf, tmp-http, tmp-motion,
# tmp-shots) et le supprime a l'entree du run: aucun ne doit etre versionne. Le
# motif exact 'tmp-data/' en laissait echapper un (test/tmp-motion/settings.json
# est entre dans un commit). D'ou le joker.
test/tmp-*/
test/shots/
# Le journal du lot de portes (scripts/run-all-gates.py): il porte des rc, donc
# il est perissable et ne se juge que sur place. Versionner un journal de rc produit un
# diff a chaque run et, pis, un etat « vert » herite qu'on relit comme une preuve.
test/gates.out
# Les verdicts des lots et des preuves negatives sont DES artefacts: consignes pour
# etre relues dans la fouillee, jamais pour etre versionnees. Un .out versionne
# se lit, lui, comme un etat « vert herite » (la faute exactement chasse par ce
# depot) des qu'une porte change de consistance sous lui.
test/*.out
*.db-wal
*.db-shm

# Clés de licence (jamais commitées — elles contiennent la clé privée)
license_private.pem
*.pem
!README*

# Artefacts LFS déjà couverts par .gitattributes, mais on ignore les caches
.lfs_cache/

# Cache d'octets des harnais de mesure Python (scripts/probe-*.py). Genere a
# chaque execution, jamais une source.
__pycache__/

# Poids OCR embarques (Sprint 15 tache 7) : 12,8 Mo hors git — la lourdeur
# que le contrat refuse. Telecharges une fois hors depot, juges par empreinte
# contre scripts/modeles-ocr.manifest.json (npm run verify:ocr-modeles).
resources/ocr/modeles/

# La banque de factures reels du chef (Tache 11) : personnelles et
# confidentielles (prix + fournisseurs) — hors git. Le README reste sous git.
test/fixtures/factures/*
!test/fixtures/factures/README.md

# Builds Electron locaux (3,4 Go) — distribues hors depot, jamais versionnes
release/
# Poids linguistique tesseract telecharge hors depot (juges par empreinte comme resources/ocr)
fra.traineddata
# session Hermes locale
.hermes/
