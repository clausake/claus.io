          {
            "jour": "lundi",
            "entree": { "nom": "...", "ingredients": [{"name": "...", "quantite": 0, "unite": "g"}], "allergens": ["..."], "preparation_steps": "..." },
            "plat": { "nom": "...", "ingredients": [{"name": "...", "quantite": 0, "unite": "g"}], "allergens": ["..."], "preparation_steps": "..." },
