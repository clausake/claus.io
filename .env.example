# .env.example — les variables LUES par le projet (mesure : grep process.env).
# Rien d'inventé : chaque ligne correspond à un `process.env.X` réel.

# --- Emplacements et serveur ---
# Dossier des données (base SQLite, settings.json, uploads). Sans lui : ./data.
USER_DATA_PATH=./data
# Port d'écoute (sinon 3000). Un PORT posé est un CONTRAT : pas d'incrément
# silencieux sur EADDRINUSE.
PORT=3000
# Bind : boucle locale par défaut ; 0.0.0.0 seulement si le maître l'expose.
HOST=127.0.0.1

# --- Modes de harnais (jamais posés en production) ---
# 1 = gate de session désactivée (sondes e2e du métier).
COOKDRIVE_AUTH_OFF=1
# 1 = rate-limit désactivé (sinon le bucket auth sature les runs rapprochés).
COOKDRIVE_RATELIMIT_OFF=1
# 1 = instance HTTP de pentest (liée à HOST=0.0.0.0).
COOKDRIVE_PENTEST_HTTP=1
# 1 = agent Hermes coupé (boîte de suggestions fermée, 403 sur les écritures).
COOKDRIVE_AGENT_OFF=1
# 1 = cerveau Hermes factice et déterministe (CI, jamais de LLM réel).
COOKDRIVE_HERMES_FACTICE=1

# --- Divers lus par le code ---
# development = voie Vite ; tout le reste = voie production (dist + uploads).
NODE_ENV=development
# Répertoire dist explicite (sinon résolution automatique).
COOKDRIVE_DIST=dist
# Jeton d'instance (vérifié par la porte d'instance) et fichier de readiness.
COOKDRIVE_INSTANCE_TOKEN=
COOKDRIVE_READY_FILE=
# Lecture de l'épreuve de l'assistant (chemin d'une pièce d'épreuve).
COOKDRIVE_EPREUVE_LECTEUR=
