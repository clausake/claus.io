      const archive = archiver("zip", { zlib: { level: 9 } });
      output.on("close", () =>
        res.download(path.join(storageDir, "backup.zip")),
      );
      archive.pipe(output);
      archive.directory(storageDir, false, { date: new Date() });
      archive.finalize();
