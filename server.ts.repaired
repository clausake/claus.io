  app.get("/api/staff", async (req, res) => {
    try {
      const staff = await db.all("SELECT * FROM staff WHERE active = 1");
      const result = [];
      for (const member of staff) {
        const scheduleRows = await db.all(
          "SELECT * FROM staff_schedule WHERE staff_id = ?",
          [member.id],
        );
        const schedule = {
          monday: [],
          tuesday: [],
          wednesday: [],
          thursday: [],
          friday: [],
          saturday: [],
          sunday: [],
        };
        scheduleRows.forEach((row) => {
          if (schedule[row.day]) {
            schedule[row.day].push({
              start: row.start_time,
              end: row.end_time,
            });
          }
        });
        result.push({
          id: member.id,
          name: member.name,
          role: member.role,
          hourlyRate: member.hourly_rate,
          schedule,
        });
      }
      res.json(result);
    } catch (error) {
      res
        .status(500)
        .json({ status: "error", message: "Failed to fetch staff" });
    }
  });
  app.post("/api/staff", async (req, res) => {
    try {
      const { id, name, role, hourlyRate, schedule } = req.body;
      const staffId = id || Math.random().toString(36).substring(2, 9);
      await db.run(
        "INSERT OR REPLACE INTO staff (id, name, role, hourly_rate) VALUES (?, ?, ?, ?)",
        [staffId, name, role, hourlyRate],
      );
      if (schedule) {
        await db.run("DELETE FROM staff_schedule WHERE staff_id = ?", [
          staffId,
        ]);
        for (const day of Object.keys(schedule)) {
          for (const slot of schedule[day]) {
            await db.run(
              "INSERT INTO staff_schedule (id, staff_id, day, start_time, end_time) VALUES (?, ?, ?, ?, ?)",
              [
                Math.random().toString(36).substring(2, 9),
                staffId,
                day,
                slot.start,
                slot.end,
              ],
            );
          }
        }
      }
      res.json({ status: "success", id: staffId });
    } catch (error) {
      console.error(error);
      res
        .status(500)
        .json({ status: "error", message: "Failed to save staff member" });
    }
  });
