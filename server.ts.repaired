        Message utilisateur: "${message}"`,
        system:
          settings.language === "es"
            ? "Eres un asistente culinario profesional. Operas estrictamente en espa\xF1ol."
            : settings.language === "en"
              ? "You are a professional culinary assistant. You operate strictly in English."
              : "Tu es un assistant culinaire professionnel. Tu op\xE8res strictement en fran\xE7ais.",
        options: { temperature: 0.7 },
      });
      res.json({ response: response.response });
    } catch (error) {
      console.error("Chat API Error:", error);
      res.status(500).json({
        response:
