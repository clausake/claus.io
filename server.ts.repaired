          : settings.language === "es"
            ? "Spanish"
            : settings.language === "de"
              ? "German"
              : "English";
      const response = await ollama.generate({
        model: settings.model_name,
        prompt:
          settings.language === "es"
            ? `DIRECTIVA: Eres CLAUS.IO, asistente culinario. Operas EN ESPA\xD1OL.
