# Git LFS pour les fichiers binaires lourds (PDF guides, screenshots)
# -> évite que l'historique git ne gonfle à chaque modification
public/*.pdf filter=lfs diff=lfs merge=lfs -text
public/*.png filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
screenshot.png filter=lfs diff=lfs merge=lfs -text
