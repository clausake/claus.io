          },
          ... (r\xE9p\xE9ter pour mardi \xE0 dimanche)
        ]
      }`;
        const response = await ollama.generate({
          model: targetModel,
          prompt,
          images: base64Image ? [base64Image] : void 0,
          format: "json",
          options: { temperature: 0.85, top_p: 0.95 },
        });
        let cleanResponse = response.response;
        const jsonMatch = cleanResponse.match(/\{[\s\S]*\}/);
        if (jsonMatch) cleanResponse = jsonMatch[0];
        res.json(JSON.parse(cleanResponse));
      } catch (error) {
        console.error(error);
        res.status(500).json({ error: "Processing failed" });
      }
    },
  );
  app.post(
